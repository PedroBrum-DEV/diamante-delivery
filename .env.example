# Copy to .env (git-ignored). The order-service reads it automatically on startup.
# Alternatively, export these as environment variables.

# --- Option A: OpenAI (default) ---
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# --- Option B: local model (LM Studio / Ollama) ---
# Run with: SPRING_PROFILES_ACTIVE=local
# OPENAI_BASE_URL=http://localhost:1234/v1     # LM Studio
# OPENAI_BASE_URL=http://localhost:11434/v1    # Ollama
# OPENAI_MODEL=the-model-name-loaded-in-the-server
